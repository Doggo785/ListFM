LASTFM_API_KEY=lastfm_api
LASTFM_API_SECRET=lastfm_secret
# Local dev uses Docker Postgres on port 5433; CI uses port 5432.
DATABASE_URL=postgresql+asyncpg://listfm:listfm@localhost:5433/listfm
JWT_SECRET=your-jwt-secret-min-32-chars-long-here
COOKIE_SECURE=false
# Header the proxy in front sets to the visitor's IP (Cloudflare: CF-Connecting-IP). Empty: the socket address.
TRUSTED_IP_HEADER=

# OAuth — Google & Discord (leave blank to disable)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Outgoing mail (confirmation and reset links). Empty host: each mail is printed in the console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ListFM <listfm@example.com>"
